{
  "name": "paydecode",
  "version": "0.1.0",
  "description": "Decode agent-payment artifacts (x402, AP2, EIP-3009, Solana) into plain English with risk flags.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "paydecode": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "x402",
    "ap2",
    "agent-payments",
    "eip-3009",
    "usdc",
    "decoder",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "viem": "^2.57.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  }
}
