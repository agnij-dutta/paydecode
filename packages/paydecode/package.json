{
  "name": "paydecode",
  "version": "0.1.0",
  "description": "Decode agent-payment artifacts (x402, AP2, EIP-3009, Permit2, Solana, MPP, ACP, Visa TAP) into plain English with risk flags. jwt.io for agent payments.",
  "keywords": [
    "x402",
    "ap2",
    "agent-payments",
    "eip-3009",
    "eip-712",
    "permit2",
    "usdc",
    "solana",
    "sd-jwt",
    "mpp",
    "acp",
    "visa-tap",
    "decoder",
    "ai-agents",
    "cli"
  ],
  "homepage": "https://github.com/agnij-dutta/paydecode#readme",
  "bugs": {
    "url": "https://github.com/agnij-dutta/paydecode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/paydecode.git",
    "directory": "packages/paydecode"
  },
  "license": "MIT",
  "author": "Agnij Dutta (https://x.com/0xholmesdev)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "paydecode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node --experimental-strip-types scripts/gen-fixtures.mts",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "viem": "^2.57.2",
    "vitest": "^5.0.3"
  }
}
